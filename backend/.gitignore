# Python / venv
.venv/
**/.venv/
*.egg-info/
__pycache__/
**/__pycache__/
*.pyc

# Test/cache/logs
**/.pytest_cache/
**/*.log
.tmp/

# Env files / secrets
.env
**/.env

# Runtime / generated data
# Keep only intentional placeholders or small deterministic fixtures in git.
data/**/*.json
data/**/*.sqlite3
data/**/*.manifest.json
data/**/*.lock
!data/.gitkeep
!data/README.md
!data/gyms_test.json
!data/registry_test.json
!data/registry.json

data/artifacts/
data/jobs/

# openapi.json is intentionally tracked as a CI contract snapshot.
# It must match the live FastAPI app on every push.
