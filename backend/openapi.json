    "/readyz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readyz",
        "description": "Readiness probe.\n\nConfirms external dependencies (DB + extension + schema) are available.\n\nReturns 503 when NOT ready.\n\n503 responses are returned using the global error envelope:\n\n{\n    \"error\": {\n        \"code\": 503,\n        \"message\": {\n            \"ready\": false,\n            \"checks\": {...}\n        }\n    }\n}",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
